{{ 'section-dirt-clips-carousel.css' | asset_url | stylesheet_tag }}

<section
  id="DirtClips-{{ section.id }}"
  class="dirt-clips-carousel ferxsport-contained"
  data-dirt-clips
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}"
  style="
    --dirt-clips-width: {{ section.settings.content_max_width | default: 1100 }};
    --ferxsport-contained-width: {{ section.settings.content_max_width | default: 1100 }};
    --dirt-clips-columns: {{ section.settings.columns | default: 4 }};
    --dirt-clips-visible: {{ section.settings.columns | default: 4 }};
    --dirt-clips-padding-block: {{ section.settings.padding_block | default: 64 }};
    --dirt-clips-padding-inline: {{ section.settings.padding_inline | default: 0 }};
    {% if section.settings.background_color != blank %}
      --dirt-clips-bg: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.heading_color != blank %}
      --dirt-clips-heading-color: {{ section.settings.heading_color }};
    {% endif %}
  "
>
  <div class="dirt-clips-carousel__inner">
    {% if section.settings.heading != blank %}
      <h2 class="dirt-clips-carousel__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="dirt-clips-carousel__viewport" data-dirt-clips-viewport>
      <ul class="dirt-clips-carousel__track" data-dirt-clips-track role="list">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% liquid
              assign cover_image = block.settings.cover_image
              if cover_image == blank and block.settings.source == 'uploaded' and block.settings.video != blank
                assign cover_image = block.settings.video.preview_image
              endif

              assign has_video = false
              assign video_type = ''
              assign video_id = ''
              assign video_src = ''

              if block.settings.source == 'url' and block.settings.video_url != blank
                assign has_video = true
                assign video_type = block.settings.video_url.type
                assign video_id = block.settings.video_url.id
              elsif block.settings.source == 'uploaded' and block.settings.video != blank
                assign has_video = true
                assign video_type = 'upload'
                assign video_src = block.settings.video.sources[1].url | default: block.settings.video.sources[0].url
              endif

              assign author_display = block.settings.author
              unless author_display contains '@'
                if author_display != blank
                  assign author_display = author_display | prepend: '@'
                endif
              endunless
            %}

            <li
              class="dirt-clips-carousel__slide"
              data-dirt-clips-slide
              {{ block.shopify_attributes }}
            >
              <article class="dirt-clips-carousel__card">
                <div class="dirt-clips-carousel__media">
                  {% if cover_image != blank %}
                    {{
                      cover_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '400,600,800',
                        sizes: '(min-width: 769px) 25vw, 78vw',
                        alt: block.settings.video_title | default: author_display
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'dirt-clips-carousel__placeholder' }}
                  {% endif %}

                  <span class="dirt-clips-carousel__media-overlay" aria-hidden="true"></span>

                  {% if block.settings.video_title != blank %}
                    <p class="dirt-clips-carousel__video-title">{{ block.settings.video_title }}</p>
                  {% endif %}

                  {% if has_video %}
                    <button
                      type="button"
                      class="dirt-clips-carousel__play"
                      data-dirt-clips-play
                      data-video-type="{{ video_type }}"
                      {% if video_type == 'youtube' or video_type == 'vimeo' %}
                        data-video-id="{{ video_id }}"
                      {% elsif video_type == 'upload' %}
                        data-video-src="{{ video_src }}"
                      {% endif %}
                      aria-label="{{ 'accessibility.play_video' | t | default: 'Play video' }}"
                    >
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  {% endif %}
                </div>

                <div class="dirt-clips-carousel__meta">
                  <div class="dirt-clips-carousel__meta-text">
                    {% if author_display != blank %}
                      <p class="dirt-clips-carousel__author">{{ author_display }}</p>
                    {% endif %}
                    {% if block.settings.date != blank %}
                      <p class="dirt-clips-carousel__date">{{ block.settings.date }}</p>
                    {% endif %}
                  </div>

                  {% if block.settings.product_image != blank %}
                    {{
                      block.settings.product_image
                      | image_url: width: 88
                      | image_tag:
                        loading: 'lazy',
                        class: 'dirt-clips-carousel__product-thumb',
                        widths: '44,88',
                        sizes: '44px',
                        alt: block.settings.product_image.alt | default: 'Product'
                    }}
                  {% endif %}
                </div>
              </article>
            </li>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <li class="dirt-clips-carousel__slide" data-dirt-clips-slide>
              <article class="dirt-clips-carousel__card">
                <div class="dirt-clips-carousel__media">
                  {{ 'image' | placeholder_svg_tag: 'dirt-clips-carousel__placeholder' }}
                  <span class="dirt-clips-carousel__media-overlay" aria-hidden="true"></span>
                  <p class="dirt-clips-carousel__video-title">Valtinsu EM-5 Pro Electric Dirt Bike Review</p>
                  <button type="button" class="dirt-clips-carousel__play" disabled aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
                <div class="dirt-clips-carousel__meta">
                  <div class="dirt-clips-carousel__meta-text">
                    <p class="dirt-clips-carousel__author">@RunPlayBack</p>
                    <p class="dirt-clips-carousel__date">April 11, 2026</p>
                  </div>
                </div>
              </article>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    {% if section.settings.button_label != blank %}
      <div class="dirt-clips-carousel__actions">
        {% if section.settings.button_link != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="dirt-clips-carousel__cta ferxsport-homepage-btn"
            {% if section.settings.button_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ section.settings.button_label }}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% else %}
          <span class="dirt-clips-carousel__cta ferxsport-homepage-btn">
            {{ section.settings.button_label }}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <dialog class="dirt-clips-carousel__modal" data-dirt-clips-modal aria-label="Video player">
    <div class="dirt-clips-carousel__modal-inner">
      <button type="button" class="dirt-clips-carousel__modal-close" data-dirt-clips-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="dirt-clips-carousel__modal-media" data-dirt-clips-modal-media></div>
    </div>
  </dialog>
</section>

<script>
  (() => {
    const section = document.getElementById('DirtClips-{{ section.id }}');
    if (!section) return;

    const viewport = section.querySelector('[data-dirt-clips-viewport]');
    const track = section.querySelector('[data-dirt-clips-track]');
    const modal = section.querySelector('[data-dirt-clips-modal]');
    const modalMedia = section.querySelector('[data-dirt-clips-modal-media]');
    const closeBtn = section.querySelector('[data-dirt-clips-close]');

    const autoplayEnabled = section.dataset.autoplay !== 'false';
    const autoplaySpeed = Math.max(3, Number(section.dataset.autoplaySpeed) || 5) * 1000;

    let timer = null;
    let paused = false;
    let activeIndex = 0;
    let slideCount = 0;
    let loopPending = false;

    const getTrackSlides = () => [...track.querySelectorAll('[data-dirt-clips-slide]')];

    const setupLoopClones = () => {
      if (!track) return;

      track.querySelectorAll('[data-dirt-clips-clone]').forEach((clone) => clone.remove());

      const originals = [...track.querySelectorAll('[data-dirt-clips-slide]:not([data-dirt-clips-clone])')];
      slideCount = originals.length;

      if (slideCount < 2) return;

      // Append enough clones so the last real slide can be followed by the
      // beginning of the set again, creating a seamless infinite carousel.
      const visibleMobile = 1.8;
      const clonesNeeded = Math.ceil(visibleMobile) + 1;
      for (let i = 0; i < clonesNeeded; i++) {
        const original = originals[i % slideCount];
        const loopClone = original.cloneNode(true);
        loopClone.setAttribute('data-dirt-clips-clone', 'true');
        loopClone.setAttribute('aria-hidden', 'true');
        loopClone.removeAttribute('id');
        track.appendChild(loopClone);
      }
    };

    const getGap = () => {
      if (!track) return 0;
      const styles = getComputedStyle(track);
      return parseFloat(styles.columnGap || styles.gap || '0') || 0;
    };

    const getStep = () => {
      const slides = getTrackSlides();
      const slide = slides[0];
      if (!slide) return 0;
      return slide.offsetWidth + getGap();
    };

    const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

    const syncSlideWidths = () => {
      if (!viewport || !track) return;

      const slides = getTrackSlides();
      if (!slides.length) return;

      const styles = getComputedStyle(section);
      const gap = getGap();
      let slideWidth;

      if (isMobile()) {
        slideWidth = viewport.clientWidth / 1.8;
      } else {
        const visible = parseFloat(styles.getPropertyValue('--dirt-clips-visible')) || 4;
        slideWidth = Math.max(0, (viewport.clientWidth - gap * Math.max(0, visible - 1)) / visible);
      }

      slides.forEach((slide) => {
        slide.style.flexBasis = `${slideWidth}px`;
        slide.style.width = `${slideWidth}px`;
      });
    };

    const applyTransform = (animate = true) => {
      if (!track) return;
      track.style.transition = animate ? 'transform 0.55s ease' : 'none';
      track.style.transform = `translate3d(-${activeIndex * getStep()}px, 0, 0)`;
    };

    const resetLoop = () => {
      loopPending = false;
      activeIndex = activeIndex - slideCount;
      applyTransform(false);
    };

    const onTrackTransitionEnd = (event) => {
      if (event.target !== track || event.propertyName !== 'transform' || !loopPending) return;
      resetLoop();
    };

    track?.addEventListener('transitionend', onTrackTransitionEnd);

    const goToIndex = (index, animate = true) => {
      if (slideCount < 2) return;
      activeIndex = Math.max(0, Math.min(index, slideCount));
      loopPending = false;
      applyTransform(animate);
    };

    const advance = () => {
      if (slideCount < 2) return;

      activeIndex += 1;
      applyTransform(true);

      // Once we scroll past the last original slide, we are viewing clones
      // that match the first slides. Quietly jump back to the same offset
      // without animation so the loop feels infinite.
      if (activeIndex >= slideCount) {
        loopPending = true;
      }
    };

    const stopAutoplay = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!autoplayEnabled || paused || slideCount < 2 || !track) return;

      timer = setInterval(advance, autoplaySpeed);
    };

    const refreshLayout = (animate = false) => {
      if (activeIndex > slideCount) activeIndex = 0;
      syncSlideWidths();
      applyTransform(animate);
    };

    const clearModalMedia = () => {
      if (!modalMedia) return;
      modalMedia.innerHTML = '';
    };

    const openModal = (button) => {
      if (!modal || !modalMedia || !button) return;

      clearModalMedia();
      const type = button.dataset.videoType;
      const id = button.dataset.videoId;
      const src = button.dataset.videoSrc;

      if (type === 'youtube' && id) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.title = 'YouTube video player';
        modalMedia.appendChild(iframe);
      } else if (type === 'vimeo' && id) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = 'Vimeo video player';
        modalMedia.appendChild(iframe);
      } else if (type === 'upload' && src) {
        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        modalMedia.appendChild(video);
      } else {
        return;
      }

      paused = true;
      stopAutoplay();
      modal.showModal();
    };

    const closeModal = () => {
      if (!modal?.open) return;
      modal.close();
      clearModalMedia();
      paused = false;
      startAutoplay();
    };

    section.querySelectorAll('[data-dirt-clips-play]').forEach((button) => {
      button.addEventListener('click', () => openModal(button));
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    modal?.addEventListener('close', () => {
      clearModalMedia();
      paused = false;
      startAutoplay();
    });

    viewport?.addEventListener('mouseenter', () => {
      paused = true;
      stopAutoplay();
    });

    viewport?.addEventListener('mouseleave', () => {
      if (modal?.open) return;
      paused = false;
      startAutoplay();
    });

    window.addEventListener('resize', () => refreshLayout(false));

    if (typeof ResizeObserver !== 'undefined' && viewport) {
      const observer = new ResizeObserver(() => refreshLayout(false));
      observer.observe(viewport);
    }

    const boot = () => {
      setupLoopClones();
      activeIndex = 0;
      loopPending = false;
      refreshLayout(false);
      startAutoplay();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      requestAnimationFrame(boot);
    }
  })();
</script>

{% schema %}
{
  "name": "Dirt clips carousel",
  "tag": "section",
  "class": "dirt-clips-carousel-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dirt Clips From Thousands Of Creators"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width (design px)",
      "min": 900,
      "max": 1440,
      "step": 10,
      "default": 1100,
      "info": "Based on 1440 design. Scales with --rem."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Visible columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto carousel speed (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "Bottom button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore All Videos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding (design px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding (design px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video clip",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Video source",
          "options": [
            {
              "value": "url",
              "label": "YouTube / Vimeo URL"
            },
            {
              "value": "uploaded",
              "label": "Uploaded video"
            }
          ],
          "default": "url"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "visible_if": "{{ block.settings.source == 'url' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.source == 'uploaded' }}"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image",
          "info": "Shown before play. Falls back to uploaded video preview if empty."
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video title",
          "default": "Valtinsu EM-5 Pro Electric Dirt Bike Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "@RunPlayBack",
          "info": "Add @ or it will be added automatically."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "April 11, 2026"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dirt clips carousel",
      "blocks": [
        {
          "type": "clip",
          "settings": {
            "video_title": "Valtinsu EM-5 Pro Electric Dirt Bike Review",
            "author": "@RunPlayBack",
            "date": "April 11, 2026"
          }
        },
        {
          "type": "clip",
          "settings": {
            "video_title": "First Ride on the EM-5 Pro",
            "author": "@DirtRider",
            "date": "March 28, 2026"
          }
        },
        {
          "type": "clip",
          "settings": {
            "video_title": "Trail Test: Valtinsu Electric Bike",
            "author": "@OffRoadTV",
            "date": "March 15, 2026"
          }
        },
        {
          "type": "clip",
          "settings": {
            "video_title": "EM-5 Pro vs Gas Dirt Bike",
            "author": "@RideCompare",
            "date": "February 20, 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
