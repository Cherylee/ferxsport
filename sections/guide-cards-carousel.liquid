{{ 'section-guide-cards-carousel.css' | asset_url | stylesheet_tag }}

<section
  id="GuideCards-{{ section.id }}"
  class="guide-cards ferxsport-contained"
  style="
    --ferxsport-contained-width: {{ section.settings.content_max_width | default: 1100 }};
    --guide-cards-columns: {{ section.settings.columns | default: 3 }};
    --guide-cards-padding-block: {{ section.settings.padding_block | default: 64 }};
    --guide-cards-padding-inline: {{ section.settings.padding_inline | default: 0 }};
    {% if section.settings.background_color != blank %}
      --guide-cards-bg: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.heading_color != blank %}
      --guide-cards-heading-color: {{ section.settings.heading_color }};
    {% endif %}
    {% if section.settings.title_color != blank %}
      --guide-cards-title-color: {{ section.settings.title_color }};
    {% endif %}
    {% if section.settings.subtitle_color != blank %}
      --guide-cards-subtitle-color: {{ section.settings.subtitle_color }};
    {% endif %}
  "
>
  <div class="guide-cards__inner">
    {% if section.settings.heading != blank or section.settings.button_label != blank %}
      <header class="guide-cards__header">
        {% if section.settings.heading != blank %}
          <h2 class="guide-cards__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.button_label != blank %}
          {% if section.settings.button_link != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="guide-cards__cta ferxsport-homepage-btn"
              {% if section.settings.button_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.button_label }}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% else %}
            <span class="guide-cards__cta ferxsport-homepage-btn">
              {{ section.settings.button_label }}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% endif %}
        {% endif %}
      </header>
    {% endif %}

    <div class="guide-cards__carousel">
      <button
        type="button"
        class="guide-cards__arrow guide-cards__arrow--prev"
        data-guide-prev
        aria-label="Previous"
        disabled
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <ul class="guide-cards__track" data-guide-track role="list">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <li class="guide-cards__slide" data-guide-slide {{ block.shopify_attributes }}>
              <article class="guide-cards__card">
                {% if block.settings.image != blank %}
                  {% if block.settings.card_link != blank %}
                    <a
                      href="{{ block.settings.card_link }}"
                      class="guide-cards__media"
                      {% if block.settings.card_link_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    >
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 769px) 33vw, 78vw',
                          alt: block.settings.image.alt | default: block.settings.title
                      }}
                    </a>
                  {% else %}
                    <div class="guide-cards__media">
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 900',
                          sizes: '(min-width: 769px) 33vw, 78vw',
                          alt: block.settings.image.alt | default: block.settings.title
                      }}
                    </div>
                  {% endif %}
                {% else %}
                  <div class="guide-cards__media">
                    {{ 'image' | placeholder_svg_tag: 'guide-cards__placeholder' }}
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  {% if block.settings.card_link != blank %}
                    <h3 class="guide-cards__title">
                      <a
                        href="{{ block.settings.card_link }}"
                        class="guide-cards__title-link"
                        {% if block.settings.card_link_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >
                        {{ block.settings.title }}
                      </a>
                    </h3>
                  {% else %}
                    <h3 class="guide-cards__title">{{ block.settings.title }}</h3>
                  {% endif %}
                {% endif %}

                {% if block.settings.subtitle != blank %}
                  <p class="guide-cards__subtitle">{{ block.settings.subtitle }}</p>
                {% endif %}
              </article>
            </li>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <li class="guide-cards__slide" data-guide-slide>
              <article class="guide-cards__card">
                <div class="guide-cards__media">
                  {{ 'image' | placeholder_svg_tag: 'guide-cards__placeholder' }}
                </div>
                <h3 class="guide-cards__title">How To Choose The Right Electric Dirt Bike For Your Terrain</h3>
                <p class="guide-cards__subtitle">JUL 05, 2026</p>
              </article>
            </li>
          {% endfor %}
        {% endif %}
      </ul>

      <button
        type="button"
        class="guide-cards__arrow guide-cards__arrow--next"
        data-guide-next
        aria-label="Next"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('GuideCards-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('[data-guide-track]');
    const prevBtn = section.querySelector('[data-guide-prev]');
    const nextBtn = section.querySelector('[data-guide-next]');
    const slides = [...section.querySelectorAll('[data-guide-slide]')];

    const getGap = () => {
      if (!track) return 0;
      const styles = getComputedStyle(track);
      return parseFloat(styles.columnGap || styles.gap || '0') || 0;
    };

    const getStep = () => {
      const slide = slides[0];
      if (!slide) return 0;
      return slide.offsetWidth + getGap();
    };

    const updateNav = () => {
      if (!track || !prevBtn || !nextBtn) return;

      if (slides.length <= {{ section.settings.columns | default: 3 }}) {
        prevBtn.hidden = true;
        nextBtn.hidden = true;
        return;
      }

      prevBtn.hidden = false;
      nextBtn.hidden = false;

      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
      const atStart = track.scrollLeft <= 4;
      const atEnd = maxScroll <= 4 || track.scrollLeft >= maxScroll - 4;

      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    };

    const scrollToSlide = (direction) => {
      if (!track || !slides[0]) return;
      if (direction < 0 && prevBtn?.disabled) return;
      if (direction > 0 && nextBtn?.disabled) return;
      track.scrollBy({ left: direction * getStep(), behavior: 'smooth' });
    };

    prevBtn?.addEventListener('click', () => scrollToSlide(-1));
    nextBtn?.addEventListener('click', () => scrollToSlide(1));
    track?.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);
    updateNav();
  })();
</script>

{% schema %}
{
  "name": "Guide cards carousel",
  "tag": "section",
  "class": "guide-cards-carousel-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Dirt Bike Guides"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Header button label",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Header button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open header button in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width (design px)",
      "min": 900,
      "max": 1440,
      "step": 10,
      "default": 1100
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Visible columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Card subtitle color",
      "default": "#8c8c8c"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding (design px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding (design px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How To Choose The Right Electric Dirt Bike For Your Terrain"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / date",
          "default": "JUL 05, 2026"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card link"
        },
        {
          "type": "checkbox",
          "id": "card_link_new_tab",
          "label": "Open card link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide cards carousel",
      "blocks": [
        {
          "type": "guide_card",
          "settings": {
            "title": "How To Choose The Right Electric Dirt Bike For Your Terrain",
            "subtitle": "JUL 05, 2026"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "title": "5 Maintenance Tips Every Dirt Bike Owner Should Know",
            "subtitle": "JUN 28, 2026"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "title": "Trail Riding vs Track Riding: Which Setup Is Right For You?",
            "subtitle": "JUN 15, 2026"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "title": "Beginner's Guide To Electric Dirt Bike Battery Care",
            "subtitle": "MAY 30, 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
