{{ 'section-feature-cards.css' | asset_url | stylesheet_tag }}

<section
  id="FeatureCards-{{ section.id }}"
  class="feature-cards"
  style="
    --feature-cards-bg: {{ section.settings.background_color }};
    --feature-cards-card-bg: {{ section.settings.card_background_color }};
    --feature-cards-title-color: {{ section.settings.title_color }};
    --feature-cards-subtitle-color: {{ section.settings.subtitle_color }};
    --feature-cards-width: {{ section.settings.content_max_width }};
    --feature-cards-gap: {{ section.settings.card_gap }};
    --feature-cards-padding-block: {{ section.settings.padding_block }};
    --feature-cards-padding-inline: {{ section.settings.padding_inline }};
    --feature-cards-columns: {{ section.blocks.size | at_least: 1 }};
    margin-block-start: calc({{ section.settings.margin_top }} * var(--rem));
    margin-block-end: calc({{ section.settings.margin_bottom }} * var(--rem));
  "
>
  <div class="feature-cards__inner">
    <ul class="feature-cards__grid" role="list">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <article class="feature-cards__card">
            <div class="feature-cards__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: '(min-width: 768px) 540px, 100vw',
                    alt: block.settings.image.alt | default: block.settings.title | escape
                }}
              {% else %}
                <div class="feature-cards__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="feature-cards__body">
              {% if block.settings.title != blank %}
                <h3 class="feature-cards__title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.subtitle != blank %}
                <p class="feature-cards__subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="feature-cards__actions">
                  {% if block.settings.button_link != blank %}
                    <a
                      class="feature-cards__btn ferxsport-homepage-btn"
                      href="{{ block.settings.button_link }}"
                      {% if block.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    >
                      <span>{{ block.settings.button_label }}</span>
                      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                    </a>
                  {% else %}
                    <span class="feature-cards__btn ferxsport-homepage-btn">
                      <span>{{ block.settings.button_label }}</span>
                      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Feature cards",
  "tag": "section",
  "class": "feature-cards-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#8c8c8c"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Find a Valtinsu Dealer Nearby"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Find your nearest dealer to explore Valtinsu in person, test ride our models, and get expert guidance."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Find A Dealer"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open button link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Find a Valtinsu Dealer Nearby",
            "subtitle": "Find your nearest dealer to explore Valtinsu in person, test ride our models, and get expert guidance.",
            "button_label": "Find A Dealer"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Support That Stays With Your Ride",
            "subtitle": "From setup to service, our team is here to help you get the most out of every ride.",
            "button_label": "Get Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
