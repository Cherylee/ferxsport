{{ 'section-benefits-bar.css' | asset_url | stylesheet_tag }}

<section
  id="BenefitsBar-{{ section.id }}"
  class="benefits-bar"
  style="
    --benefits-bar-bg: {{ section.settings.background_color }};
    --benefits-bar-card-bg: {{ section.settings.card_background_color }};
    --benefits-bar-icon-color: {{ section.settings.icon_color }};
    --benefits-bar-text-color: {{ section.settings.text_color }};
    --benefits-bar-width: {{ section.settings.content_max_width }};
    --benefits-bar-gap: {{ section.settings.card_gap }};
    --benefits-bar-padding-block: {{ section.settings.padding_block }};
    --benefits-bar-padding-inline: {{ section.settings.padding_inline }};
    --benefits-bar-columns: {{ section.blocks.size | at_least: 1 }};
    margin-block-start: calc({{ section.settings.margin_top }} * var(--rem));
    margin-block-end: calc({{ section.settings.margin_bottom }} * var(--rem));
  "
>
  <div class="benefits-bar__inner ferxsport-contained" style="--ferxsport-contained-width: {{ section.settings.content_max_width | default: 1100 }};">
    <ul class="benefits-bar__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign heading = block.settings.heading | strip
          assign emphasis = block.settings.emphasis_phrase | strip
          assign emphasis_link = block.settings.emphasis_link
          assign has_emphasis = false
          if emphasis != blank and heading contains emphasis
            assign has_emphasis = true
            assign parts = heading | split: emphasis
          endif
        %}

        <li {{ block.shopify_attributes }}>
          <div class="benefits-bar__card">
            <span class="benefits-bar__icon" aria-hidden="true">
              {% if block.settings.icon == 'custom' and block.settings.custom_icon != blank %}
                {{
                  block.settings.custom_icon
                  | image_url: width: 96
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 96',
                    alt: ''
                }}
              {% else %}
                {% case block.settings.icon %}
                  {% when 'parts' %}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <circle cx="12" cy="12" r="3"></circle>
                      <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"></path>
                    </svg>
                  {% when 'warranty' %}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                  {% when 'support' %}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M3 11a9 9 0 1 1 18 0v5a3 3 0 0 1-3 3h-2"></path>
                      <path d="M3 16h2a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3"></path>
                      <path d="M21 16h-2a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h2"></path>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M1 3h15v13H1z"></path>
                      <path d="M16 8h4l3 3v5h-7V8z"></path>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                {% endcase %}
              {% endif %}
            </span>

            {% if heading != blank %}
              <p class="benefits-bar__text">
                {% if has_emphasis %}
                  {{ parts[0] -}}
                  {% if emphasis_link != blank %}
                    <a
                      class="benefits-bar__emphasis"
                      href="{{ emphasis_link }}"
                      {% if block.settings.emphasis_link_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    >
                      {{- emphasis -}}
                    </a>
                  {% else %}
                    <span class="benefits-bar__emphasis">{{ emphasis }}</span>
                  {% endif %}
                  {{- parts[1] }}
                {% else %}
                  {{ heading }}
                {% endif %}
              </p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Benefits bar",
  "tag": "section",
  "class": "benefits-bar-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ff7223"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery truck" },
            { "value": "parts", "label": "Parts / gear" },
            { "value": "warranty", "label": "Warranty / wrench" },
            { "value": "support", "label": "Support / headset" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "delivery"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Text",
          "default": "Local Warehouse Delivery"
        },
        {
          "type": "text",
          "id": "emphasis_phrase",
          "label": "Underlined phrase",
          "info": "Must match part of the text above. Leave empty for no underline."
        },
        {
          "type": "url",
          "id": "emphasis_link",
          "label": "Underlined phrase link"
        },
        {
          "type": "checkbox",
          "id": "emphasis_link_new_tab",
          "label": "Open underlined link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits bar",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "delivery",
            "heading": "Local Warehouse Delivery"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "parts",
            "heading": "Fast Parts Support",
            "emphasis_phrase": "Parts Support"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "warranty",
            "heading": "1-Year Warranty",
            "emphasis_phrase": "Warranty"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Official After-Sales Support",
            "emphasis_phrase": "After-Sales Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
