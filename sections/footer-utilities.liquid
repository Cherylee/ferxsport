

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_payment_icons = section.settings.show_payment_icons
  assign utilities_columns = section.blocks.size
  if show_payment_icons
    assign utilities_columns = utilities_columns | plus: 1
  endif

  assign default_payment_types = 'american_express,apple_pay,diners_club,discover,google_pay,master,paypal,shopify_pay,unionpay,visa'
  assign custom_payment_types = section.settings.custom_payment_types | default: default_payment_types | split: ','
  assign store_payment_types = shop.enabled_payment_types

  assign payment_types = custom_payment_types
  if section.settings.payment_icons_mode != 'custom' and store_payment_types.size > 0
    assign payment_types = store_payment_types
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  {{ section.shopify_attributes }}
>
  <div
    class="utilities utilities--blocks-{{ utilities_columns }}{% if show_payment_icons %} utilities--has-payments{% endif %} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;{% if section.settings.divider_color != blank %} --divider-color: {{ section.settings.divider_color }};{% endif %} --gap: {{ section.settings.gap }}px; --payment-icon-gap: {{ section.settings.payment_icon_gap | default: 6 }}px;"
    data-testid="footer-utilities"
  >
    {% content_for 'blocks' %}

    {% if show_payment_icons %}
      {% render 'footer-payment-icons', payment_types: payment_types %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .utilities {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap);
    text-wrap: nowrap;
    border-top: var(--border-width) solid var(--divider-color, var(--color-border));
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      justify-content: center;
      gap: var(--gap);
      align-items: center;
      text-align: left;
    }
  }

  .utilities a,
  .utilities button {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .utilities > * {
    text-align: center;

    @media screen and (min-width: 750px) {
      text-align: left;
      justify-self: start;
    }
  }

  /* Dynamic positioning based on number of blocks */
  @media screen and (min-width: 750px) {
    /* 1 block: Single column, left aligned */
    .utilities--blocks-1 {
      grid-template-columns: 1fr;
      justify-content: start;
    }

    .utilities--blocks-1 > * {
      justify-self: start;
      text-align: left;
    }

    /* 2 blocks: Two equal columns, start and end aligned */
    .utilities--blocks-2 {
      grid-template-columns: 1fr 1fr;
    }

    .utilities--blocks-2 > *:nth-child(2) {
      justify-self: end;
      text-align: right;
    }

    /* 3 blocks: Three columns (1fr auto 1fr), start/center/end aligned */
    .utilities--blocks-3 {
      grid-template-columns: 1fr auto 1fr;
    }

    .utilities--blocks-3 > *:nth-child(2) {
      justify-self: center;
      text-align: center;
    }

    .utilities--blocks-3 > *:nth-child(3) {
      justify-self: end;
      text-align: right;
    }

    .utilities .payment-icons__list {
      gap: var(--payment-icon-gap, calc(6 * var(--rem)));
      justify-content: flex-end;
    }
  }

  .utilities--has-payments .footer-utilities__payment-icons {
    width: auto;
  }

  .utilities--has-payments .footer-utilities__payment-icons .payment-icons__list {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--payment-icon-gap, calc(6 * var(--rem)));
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .utilities--has-payments .footer-utilities__payment-icons .payment-icons__item {
    display: flex;
    align-items: center;
  }

  .utilities--has-payments .footer-utilities__payment-icons .payment-icons__item svg {
    display: block;
    flex-shrink: 0;
    height: calc(24 * var(--rem));
    min-height: calc(24 * var(--rem));
    width: auto;
  }

  @media screen and (min-width: 750px) {
    .utilities--has-payments.utilities--blocks-3 > .footer-utilities__payment-icons {
      justify-self: end;
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 2,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "visible_if": "{{ section.settings.divider_thickness > 0 }}"
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "select",
      "id": "payment_icons_mode",
      "label": "Payment icons source",
      "options": [
        {
          "value": "auto",
          "label": "Store enabled (fallback to custom list)"
        },
        {
          "value": "custom",
          "label": "Custom list only"
        }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.show_payment_icons == true }}"
    },
    {
      "type": "text",
      "id": "custom_payment_types",
      "label": "Custom payment types",
      "info": "Comma-separated Shopify payment type handles, e.g. visa, master, paypal, apple_pay, shopify_pay",
      "default": "american_express,apple_pay,diners_club,discover,google_pay,master,paypal,shopify_pay,unionpay,visa",
      "visible_if": "{{ section.settings.show_payment_icons == true }}"
    },
    {
      "type": "range",
      "id": "payment_icon_gap",
      "label": "Payment icon gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ section.settings.show_payment_icons == true }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "settings": {
        "show_payment_icons": true,
        "payment_icon_gap": 6
      },
      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },
        "policy_list": {
          "type": "footer-policy-list"
        }
      },
      "block_order": ["copyright", "policy_list"]
    }
  ]
}
{% endschema %}
