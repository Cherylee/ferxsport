      "default": "40 MPH"
    },
    {
      "type": "text",
      "id": "product_3_spec_2_label",
      "label": "Product 3 spec 2 label",
      "default": "Battery"
    },
    {
      "type": "text",
      "id": "product_3_spec_2_value",
