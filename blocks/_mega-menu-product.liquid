      "default": "Speed"
    },
    {
      "type": "text",
      "id": "product_2_spec_1_value",
      "label": "Product 2 spec 1 value",
      "default": "40 MPH"
    },
    {
      "type": "text",
      "id": "product_2_spec_2_label",
      "label": "Product 2 spec 2 label",
      "default": "Battery"
    },
    {
      "type": "text",
      "id": "product_2_spec_2_value",
