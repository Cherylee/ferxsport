{%- doc -%}
  Config block for Product mega menu layout. Rendered via parent header menu matching.
{%- enddoc -%}

{%- comment -%} Config block — layout rendered by ferxsport-mega-menu {%- endcomment -%}

{% schema %}
{
  "name": "Mega: Product",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item_handle",
      "label": "Menu item handle or title",
      "info": "Match a top-level nav item, e.g. electric-dirt-bike or Electric Dirt Bike",
      "default": "electric-dirt-bike"
    },
    {
      "type": "header",
      "content": "Left links"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "All Electric Dirt Bikes"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link",
      "info": "Falls back to the menu item URL if empty"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "text",
      "id": "product_1_spec_1_label",
      "label": "Product 1 spec 1 label",
      "default": "Speed"
    },
    {
      "type": "text",
      "id": "product_1_spec_1_value",
      "label": "Product 1 spec 1 value",
      "default": "40 MPH"
    },
    {
      "type": "text",
      "id": "product_1_spec_2_label",
