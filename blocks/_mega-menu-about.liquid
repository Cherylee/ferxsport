{%- doc -%}
  About mega menu — renders when closest.link matches menu_item_handle.
{%- enddoc -%}

{% if parent_link != blank %}
  {% liquid
    assign configured = block.settings.menu_item_handle | strip
    assign is_match = false
    if configured != blank
      assign link_handle = parent_link.handle | handleize
      assign configured_handle = configured | handleize
      assign link_title = parent_link.title | strip | downcase
      assign configured_title = configured | downcase
      if configured_handle == link_handle or configured_title == link_title or configured == parent_link.title or configured == parent_link.handle
        assign is_match = true
      endif
    endif
    assign mega_context = mega_menu_context | default: 'desktop'
  %}
  {% if is_match %}
    {% render 'mega-menu-about',
      parent_link: parent_link,
      mega_block: block,
      context: mega_context
    %}
  {% endif %}
{% else %}
  <div class="ferxsport-mega-config-entry" hidden aria-hidden="true" {{ block.shopify_attributes }}></div>
{% endif %}

{% schema %}
{
  "name": "Mega: About",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item_handle",
      "label": "Menu item handle or title",
      "default": "about"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Title",
      "default": "Blog"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Description",
      "default": "Trail guides, maintenance tips and rider stories from the dirt."
    },
    {
      "type": "url",
      "id": "card_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Description",
      "default": "Why we build electric dirt bikes — and who rides behind the badge."
    },
    {
      "type": "url",
      "id": "card_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "card_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Title",
      "default": "Affiliate"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Description",
      "default": "Share your ride, grow your following and earn on every referral."
    },
    {
      "type": "url",
      "id": "card_3_link",
      "label": "Link"
    }
  ]
}
{% endschema %}
