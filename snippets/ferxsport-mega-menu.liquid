{%- doc -%}
  Matches a configured mega menu block by parent link handle and renders the layout.

  @param {object} parent_link - Top-level menu link
  @param {object} [mega_blocks] - Nested mega menu config blocks from _header-menu
  @param {object} [menu_block] - Deprecated alias for parent block (uses mega_blocks or menu_block.blocks)
  @param {string} [context] - 'desktop' or 'drawer'
{%- enddoc -%}

{% liquid
  assign context = context | default: 'desktop'
  assign matched_block = nil
  assign matched_type = ''

  assign config_blocks = mega_blocks
  if config_blocks == blank and menu_block != blank
    assign config_blocks = menu_block.blocks
  endif

  if config_blocks != blank and parent_link != blank
    assign link_handle = parent_link.handle | strip | handleize
    assign link_title = parent_link.title | strip | downcase

    for child_block in config_blocks
      assign configured = child_block.settings.menu_item_handle | strip
      if configured == blank
        continue
      endif

      assign configured_handle = configured | handleize
      assign configured_title = configured | downcase

      if configured_handle == link_handle or configured_title == link_title or configured == parent_link.title or configured == parent_link.handle
        assign matched_block = child_block
        assign matched_type = child_block.type
        break
      endif
    endfor
  endif
%}

{% if matched_block != blank %}
  {% case matched_type %}
    {% when '_mega-menu-product' %}
      {% render 'mega-menu-product',
        parent_link: parent_link,
        mega_block: matched_block,
        context: context
      %}
    {% when '_mega-menu-about' %}
      {% render 'mega-menu-about',
        parent_link: parent_link,
        mega_block: matched_block,
        context: context
      %}
    {% when '_mega-menu-support' %}
      {% render 'mega-menu-support',
        parent_link: parent_link,
        mega_block: matched_block,
        context: context
      %}
  {% endcase %}
{% endif %}
